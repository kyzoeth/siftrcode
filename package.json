{
  "name": "siftrcode",
  "version": "0.1.1",
  "description": "AST-powered codebase skeletonizer and context pruner for AI coding agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "siftrcode": "dist/bin/siftrcode.js",
    "siftr": "dist/bin/siftrcode.js"
  },
  "files": [
    "dist",
    "src/skeleton/python_ast.py",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/skeleton/python_ast.py', 'dist/skeleton/python_ast.py')\"",
    "start": "node dist/bin/siftrcode.js",
    "serve": "node dist/server/web.js",
    "test": "node dist/tests/run_tests.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "homepage": "https://siftrcode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyzoeth/siftrcode.git"
  },
  "bugs": {
    "url": "https://github.com/kyzoeth/siftrcode/issues"
  },
  "keywords": [
    "ast",
    "ai",
    "claude",
    "cursor",
    "antigravity",
    "context",
    "token-optimization",
    "mcp",
    "model-context-protocol",
    "prompt-engineering",
    "jev"
  ],
  "author": "SiftrCode Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "glob": "^10.4.5",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/chalk": "^2.2.0"
  }
}
